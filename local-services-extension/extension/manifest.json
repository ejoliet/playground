{
  "manifest_version": 3,
  "name": "Local Services",
  "version": "0.1.0",
  "description": "Discover and open HTTP and HTTPS services on your own machine.",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "storage"
  ],
  "action": {
    "default_title": "Open Local Services"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
